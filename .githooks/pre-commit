#!/bin/sh
# Enabled per clone with: git config core.hooksPath .githooks
# Mirrors CI: formatting, lints, then the test suite. Skip once with `git commit --no-verify`.
# Builds are heavy: every cargo run on this machine shares one lock and a memory cap (see
# .githooks/cargo), so parallel worktrees take turns instead of exhausting RAM.
set -e

hooks="$(dirname "$0")"
if [ -z "$VE_BUILD_LOCK_HELD" ] && command -v flock >/dev/null 2>&1; then
    VE_BUILD_LOCK_HELD=1 exec flock /tmp/view-everything-build.lock "$0" "$@"
fi

"$hooks/cargo" fmt --all --check
"$hooks/cargo" clippy --locked --all-targets -- -D warnings
"$hooks/cargo" test --locked --quiet
