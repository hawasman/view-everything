# NOTE: Publishing to the AUR requires a public repository URL. Until then this
# builds from the local git checkout (two levels above this directory) via
# git+file://, so `makepkg` works locally. Add `url` and replace `source` when public.
# Maintainer: view-everything contributors
pkgname=view-everything-git
pkgver=0.1.0.r1.ge47ffb5
pkgrel=1
pkgdesc='Find files by name and find what is consuming disk space'
arch=('x86_64')
license=('MIT' 'Apache-2.0' 'OFL-1.1')
depends=('gcc-libs' 'glibc' 'libxcb' 'libxkbcommon' 'libxkbcommon-x11' 'vulkan-icd-loader'
         'wayland' 'libglvnd')
optdepends=('vulkan-driver: GPU rendering (any Vulkan ICD: mesa, nvidia-utils, ...)'
            'polkit: live updates on Linux (Settings > Live updates)'
            'gnome-shell-extension-appindicator: tray icon on GNOME (KDE and most other desktops need nothing)')
makedepends=('cargo' 'git')
provides=('view-everything')
conflicts=('view-everything')
source=("$pkgname::git+file://$(realpath "${startdir}/../..")")
sha256sums=('SKIP')

pkgver() {
  cd "$pkgname"
  printf '%s.r%s.g%s' "$(sed -n 's/^version = "\(.*\)"/\1/p' Cargo.toml | head -n1)" \
    "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  # The package manager updates this build: no update checks.
  cargo build --release --frozen -p ve-app --no-default-features
  cargo build --release --frozen -p ve-cli -p ve-fanotify
}

package() {
  cd "$pkgname"
  install -Dm755 target/release/view-everything "$pkgdir/usr/bin/view-everything"
  install -Dm755 target/release/ve "$pkgdir/usr/bin/ve"
  install -Dm755 target/release/ve-fanotify "$pkgdir/usr/libexec/view-everything/ve-fanotify"
  install -Dm644 packaging/linux/org.view-everything.fanotify.policy \
    "$pkgdir/usr/share/polkit-1/actions/org.view-everything.fanotify.policy"
  install -Dm644 packaging/linux/view-everything.desktop \
    "$pkgdir/usr/share/applications/view-everything.desktop"
  install -Dm644 packaging/icons/view-everything.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/view-everything.svg"
  install -Dm644 LICENSE-MIT "$pkgdir/usr/share/licenses/$pkgname/LICENSE-MIT"
  install -Dm644 LICENSE-APACHE "$pkgdir/usr/share/licenses/$pkgname/LICENSE-APACHE"
  # Instrument Sans and Instrument Serif are compiled into the binary.
  install -Dm644 crates/ve-app/assets/fonts/OFL-InstrumentSans.txt -t "$pkgdir/usr/share/licenses/$pkgname/"
  install -Dm644 crates/ve-app/assets/fonts/OFL-InstrumentSerif.txt -t "$pkgdir/usr/share/licenses/$pkgname/"
}
